PORT=3000
NOVIQ_AUTO_START=true
# Keep true until you have tested every connector. Set false only for normal external actions you explicitly trust.
NOVIQ_REQUIRE_APPROVAL_FOR_EXTERNAL_ACTIONS=true
# Set true only after you have tested the production payment-link workflow. This allows NOVIQ to issue bounded hosted payment requests without owner approval; hard per-link/daily caps still apply.
NOVIQ_ALLOW_AUTONOMOUS_PAYMENT_LINKS=false
NOVIQ_MAX_ACTIONS_PER_CYCLE=25
NOVIQ_CYCLE_MINUTES=5
NOVIQ_STRATEGY_HOURS=3

# Owner auth. Preferred: run `npm run hash-password -- "your-password"` and paste the
# printed hash below — the plaintext password then never touches disk. NOVIQ_OWNER_PASSWORD
# (plaintext) still works as a fallback for a quick local test, but is hashed in memory at
# startup with a console warning; migrate off it before this leaves your machine.
NOVIQ_OWNER_PASSWORD_HASH=
NOVIQ_OWNER_PASSWORD=CHANGE_THIS_NOW
# Optional 2FA: run `npm run setup-2fa` and paste the printed secret below, then scan the
# printed otpauth:// URI with an authenticator app. Leave blank to skip 2FA.
NOVIQ_OWNER_TOTP_SECRET=
NOVIQ_SESSION_HOURS=12
NOVIQ_LOGIN_MAX_ATTEMPTS=5
NOVIQ_LOGIN_LOCKOUT_MINUTES=15
NOVIQ_API_RATE_LIMIT=600
# Financial kill switches — hard caps enforced in code, not bypassed by the approval-force
# flag. Raise them deliberately if your real pricing needs more room.
MAX_SINGLE_PAYMENT_USD=300
MAX_DAILY_SPEND_USD=500

# AI — cost-aware model routing. Cheap models handle routine/high-volume work
# (manager task creation, follow-up copy); the best model is reserved for decisions
# that actually move money (Sales Director pricing/tier calls, CEO strategy).
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHEAP=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_MID=google/gemini-2.5-flash
OPENROUTER_MODEL_BEST=anthropic/claude-sonnet-4.5
# Back-compat: used as the mid-tier model if OPENROUTER_MODEL_MID is not set.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=NOVIQ Living Enterprise City

# Money / Square
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_API_VERSION=2026-08-19
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://YOUR-PUBLIC-HTTPS-DOMAIN/webhooks/square

# Sales email (Gmail SMTP with an app password is the simplest local setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
OUTREACH_FROM_NAME=Your Name
OUTREACH_DAILY_LIMIT=30
OUTREACH_FOLLOWUP_DAYS=3
OUTREACH_DRY_RUN=true
# Production should remain rate-limited. Make sure your outreach complies with applicable law and platform/provider rules.
OUTREACH_MAX_FOLLOWUPS_PER_LEAD=3
OUTREACH_UNSUBSCRIBE_URL=

# Prospect discovery / enrichment
# Apify is the recommended path — no business-verification gate like Google Places has.
# 1) Sign up at apify.com, 2) find "Google Maps Scraper" (compass/crawler-google-places) in the
#    Apify Store, 3) copy your API token from Settings -> Integrations.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
APIFY_MAX_RESULTS=20
# Google Places stays supported as a fallback (used only if APIFY_API_TOKEN is not set).
GOOGLE_PLACES_API_KEY=
PLACES_DEFAULT_QUERY=roofing companies in my area
PLACES_PAGE_SIZE=20
PLACES_REGION_CODE=US
HUNTER_API_KEY=
CAMPAIGN_BATCH_SIZE=50

# WordPress / WooCommerce
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WC_BASE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Generic automation escape hatch
GENERIC_WEBHOOK_URL=


# Reliability / autonomous sales loop
OPENROUTER_TIMEOUT_MS=30000
SALES_REACTION_BATCH=20
FULFILLMENT_BATCH_SIZE=10
FULFILLMENT_WEBHOOK_URL=
CALCOM_BOOKING_URL=

# Discord — live owner command center
# Create a Discord application/bot, enable the Message Content Intent only if you later add
# gateway message listening. v7 uses slash-command Interactions plus an outgoing webhook.
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_OWNER_USER_ID=
DISCORD_INTERACTION_URL=https://YOUR-PUBLIC-HTTPS-DOMAIN/webhooks/discord
